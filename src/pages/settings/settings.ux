<template>
  <div class="container">
    <text class="time">{{ time }}</text>
    <text class="title">设置</text>
    <img class="top leftButton" src="/common/back_rect.png" @click="routeBack" />
    <text class="bold spacer-large"></text>
    <div class="box">
      <scroll class="box" scroll-x="false" scroll-y="true" bounces="true">
        <div class="row" @click="goToken">
          <text class="row-label">设置令牌</text>
          <text class="row-arrow">›</text>
        </div>
        <div class="row" @click="cycleKb">
          <text class="row-label">键盘</text>
          <text class="row-value">{{ kbTypeName }}</text>
        </div>
        <div class="row" @click="goAbout">
          <text class="row-label">关于软件</text>
          <text class="row-arrow">›</text>
        </div>
        <div class="padding"></div>
      </scroll>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import { loadKbType, saveKbType } from "../../common/prefs.js"

export default {
  private: {
    time: "",
    kbType: "QWERTY"
  },

  computed: {
    kbTypeName() {
      return this.kbType === "T9" ? "9键" : "26键"
    }
  },

  onShow() {
    this.time = global.getTime()
    this.kbType = global.kbType || "QWERTY"
    const self = this
    loadKbType(function (v) {
      self.kbType = v
      global.kbType = v
    })
  },

  routeBack() {
    router.back()
  },

  // 令牌设置暂未开放：先占位，不做任何操作
  goToken() {
    prompt.showToast({ message: "令牌设置暂未开放" })
  },

  cycleKb() {
    this.kbType = this.kbType === "T9" ? "QWERTY" : "T9"
    global.kbType = this.kbType
    saveKbType(this.kbType)
  },

  goAbout() {
    router.push({ uri: "/pages/about" })
  }
}
</script>

<style>
@import "../../common/app.css";

.container {
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

.spacer-large {
  height: 140px;
}

.padding {
  height: 92px;
}

.box {
  position: relative;
  width: 100%;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

scroll {
  flex: 1;
  width: 100%;
  align-items: flex-start;
  flex-direction: column;
}

.row {
  flex-direction: row;
  align-items: center;
  width: 76%;
  height: 52px;
  background-color: #262626;
  border-radius: 100px;
  padding: 0 20px;
  margin-top: 8px;
}

.row-label {
  flex: 1;
  font-size: 26px;
  font-weight: bold;
  color: white;
  lines: 1;
}

.row-value {
  font-size: 26px;
  color: rgba(255, 255, 255, 0.6);
  lines: 1;
}

.row-arrow {
  font-size: 26px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
  lines: 1;
}
</style>
