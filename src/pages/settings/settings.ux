<template>
  <div class="container">
    <text class="time">{{ time }}</text>
    <text class="title">设置</text>
    <img class="top leftButton" src="/common/back_rect.png" @click="routeBack" />
    <text class="bold spacer-large"></text>
    <div class="box">
      <scroll class="box" scroll-x="false" scroll-y="true" bounces="true">
        <div class="row" @click="goToken">
          <text class="row-label">设置令牌</text>
          <text class="row-value">{{ tokenText }}</text>
        </div>
        <div class="row" @click="goAbout">
          <text class="row-label">关于软件</text>
          <text class="row-arrow">›</text>
        </div>
        <div class="padding"></div>
      </scroll>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import { loadCredentials, clearCredentials } from "../../common/credentials.js"

export default {
  private: {
    time: "",
    tokenText: "未设置",
    tokenSet: false,
    tokenClearArm: 0
  },

  onShow() {
    this.time = global.getTime()
    // 手环窄屏分支：键盘恒为九键 T9，本页无键盘切换入口；storage 里的旧 kbType 被忽略
    global.kbType = "T9"
    // 令牌状态：只显示是否已设置，不显示密钥
    loadCredentials(function (appid, key) {
      self.tokenSet = !!(appid && key)
      self.tokenText = self.tokenSet ? "已设置" : "未设置"
    })
  },

  routeBack() {
    router.back()
  },

  // 令牌：未设置时提示用手机插件推送；已设置时点两次清除（防误触）
  goToken() {
    if (!this.tokenSet) {
      prompt.showToast({ message: "未设置凭据，请用手机插件推送" })
      return
    }
    const now = Date.now()
    if (!this.tokenClearArm || now - this.tokenClearArm > 5000) {
      this.tokenClearArm = now
      prompt.showToast({ message: "再点一次清除凭据" })
      return
    }
    this.tokenClearArm = 0
    const self = this
    clearCredentials(function () {
      self.tokenSet = false
      self.tokenText = "未设置"
      prompt.showToast({ message: "凭据已清除" })
    })
  },

  goAbout() {
    router.push({ uri: "/pages/about" })
  }
}
</script>

<style>
@import "../../common/app.css";

.container {
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

.spacer-large {
  height: 140px;
}

.padding {
  height: 92px;
}

.box {
  position: relative;
  width: 100%;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

scroll {
  flex: 1;
  width: 100%;
  align-items: flex-start;
  flex-direction: column;
}

.row {
  flex-direction: row;
  align-items: center;
  width: 76%;
  height: 52px;
  background-color: #262626;
  border-radius: 100px;
  padding: 0 20px;
  margin-top: 8px;
}

.row-label {
  flex: 1;
  font-size: 26px;
  font-weight: bold;
  color: white;
  lines: 1;
}

.row-value {
  font-size: 26px;
  color: rgba(255, 255, 255, 0.6);
  lines: 1;
}

.row-arrow {
  font-size: 26px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
  lines: 1;
}

/* 手环窄屏（192/212 宽）：行宽 92%、字号缩小、顶部留白重算 */
@media (max-width: 220) {
  .spacer-large {
    height: 64px;
  }

  .padding {
    height: 48px;
  }

  .row {
    width: 92%;
    height: 44px;
    padding: 0 12px;
  }

  .row-label {
    font-size: 20px;
  }

  .row-value {
    font-size: 20px;
  }

  .row-arrow {
    font-size: 20px;
  }
}
</style>
