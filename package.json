{
  "name": "velatranslate",
  "version": "1.0.0",
  "description": "百度翻译（Xiaomi Watch S3/S4 圆屏）",
  "author": "kaoyu555666777",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=8.10"
  },
  "scripts": {
    "start": "aiot start --watch --enable-custom-component",
    "build": "node scripts/gen-buildinfo.js && aiot build --enable-custom-component",
    "release": "node scripts/gen-buildinfo.js && aiot release --enable-custom-component --enable-jsc",
    "lint": "eslint --format codeframe --fix --ext .ux,.js src/"
  },
  "lint-staged": {
    "*.{ux,js}": [
      "prettier --write",
      "eslint --format codeframe --fix",
      "git add"
    ],
    "*.{less,css}": [
      "prettier --write",
      "stylelint --fix --custom-syntax postcss-less",
      "git add"
    ]
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.3",
    "aiot-toolkit": "^2.0.5"
  }
}